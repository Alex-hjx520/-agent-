# DeepSeek API 配置
# 复制此文件为 .env，并填入你的真实 API Key：
#   copy .env.example .env
# .env 文件已被 .gitignore 忽略，切勿提交到版本库。

# DeepSeek API Key（从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-your-api-key-here

# DeepSeek API 基础地址
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 可选：模型名称（供 langchain-openai / openai 使用）
# DEEPSEEK_MODEL=deepseek-chat

# HuggingFace 模型下载镜像（国内网络无法直连 huggingface.co 时使用）
# 脚本已默认使用 https://hf-mirror.com；如需更换或停用可取消注释修改
# HF_ENDPOINT=https://hf-mirror.com

# 联网搜索（知识库未命中时的兜底，可选）
# 配置 TAVILY_API_KEY 后使用 Tavily（https://tavily.com 免费注册获取），质量更稳定
# 未配置时回退使用 DuckDuckGo（免 Key，但国内网络可能不可达）
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# 可选：限定联网搜索只在指定网站（域名）内搜索，逗号分隔
# 例如只搜厂商官网/权威站点；留空则搜索全网
# TAVILY_INCLUDE_DOMAINS=pump.com.cn,valve.com

# ========== MySQL 数据库配置（数据库直查模式，不用大模型时按条件查设备型号） ==========
# 复制此文件为 .env 后填入你的真实 MySQL 连接信息
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=你的数据库密码
# MYSQL_DB=equipment   # 数据库名，8 张选型表所在库


